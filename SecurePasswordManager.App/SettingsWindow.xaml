<Window x:Class="SecurePasswordManager.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="430" Width="460" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Session Timeout -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Session timeout (minutes):" VerticalAlignment="Center"/>
            <TextBox x:Name="TimeoutBox" Width="60" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Password Strength Enforcement -->
        <CheckBox 
            x:Name="EnforcePasswordStrengthCheckbox" 
            Grid.Row="1" 
            Content="Enforce password strength (block weak passwords)" 
            Margin="0,0,0,10"
            VerticalAlignment="Center"/>
        
        <TextBlock 
            Grid.Row="2" 
            Text="Minimum strength level:" 
            Margin="20,0,0,5"
            VerticalAlignment="Center"/>
        
        <ComboBox 
            x:Name="MinStrengthLevelCombo" 
            Grid.Row="3" 
            Margin="20,0,0,10"
            Height="28"
            ItemsSource="Very Weak|Weak|Fair|Good|Strong|Very Strong"
            SelectedIndex="2">
        </ComboBox>

        <TextBlock 
            Grid.Row="4" 
            Text="When unchecked: strength warnings shown only, all passwords allowed" 
            Foreground="Gray" 
            FontSize="11"
            TextWrapping="Wrap"
            Margin="0,0,0,10"/>

        <Border Grid.Row="5" BorderBrush="#D0D0D0" BorderThickness="1" Background="White" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Multi-Factor Authentication" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                <TextBlock x:Name="MfaStatusText" Text="Status: Disabled" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="EnableMfaButton" Content="Enable MFA" Width="110" Margin="0,0,8,0" Click="OnEnableMfa"/>
                    <Button x:Name="DisableMfaButton" Content="Disable MFA" Width="110" Margin="0,0,8,0" Click="OnDisableMfa"/>
                    <Button x:Name="RegenerateCodesButton" Content="Regenerate Codes" Width="130" Click="OnRegenerateCodes"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" Grid.Row="6" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Margin="0,0,10,0" Click="OnOk"/>
            <Button Content="Cancel" Width="80" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>