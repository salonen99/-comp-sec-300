<Window x:Class="SecurePasswordManager.App.EntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SecurePasswordManager.App"
        mc:Ignorable="d"
        Title="Password Entry" Height="550" Width="550"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Title -->
        <TextBlock 
            Grid.Row="0"
            x:Name="TitleText"
            Text="Add New Entry" 
            FontSize="18" 
            FontWeight="Bold"
            Foreground="#1a1a1a"
            Margin="0,0,0,20"/>
        
        <!-- Content (scrollable) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
            <StackPanel>
            
            <!-- Service Name -->
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Service Name" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox
                    x:Name="ServiceNameBox"
                    Padding="10,8"
                    FontSize="12"
                    BorderThickness="1"
                    BorderBrush="#CCCCCC"
                    Background="White"/>
                <TextBlock x:Name="ServiceNameError" Foreground="#F44336" FontSize="10" Margin="0,3,0,0"/>
            </StackPanel>
            
            <!-- Username -->
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Username / Email" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox
                    x:Name="UsernameBox"
                    Padding="10,8"
                    FontSize="12"
                    BorderThickness="1"
                    BorderBrush="#CCCCCC"
                    Background="White"/>
                <TextBlock x:Name="UsernameError" Foreground="#F44336" FontSize="10" Margin="0,3,0,0"/>
            </StackPanel>
            
            <!-- Password -->
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Password" FontWeight="Bold" Margin="0,0,0,5"/>
                <DockPanel>
                    <Button
                        x:Name="GeneratePasswordBtn"
                        Content="Generate"
                        Click="OnGeneratePassword"
                        DockPanel.Dock="Right"
                        Padding="12,8"
                        Margin="5,0,0,0"
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"
                        BorderThickness="0"/>
                    <PasswordBox
                        x:Name="PasswordBox"
                        Padding="10,8"
                        FontSize="12"
                        BorderThickness="1"
                        BorderBrush="#CCCCCC"
                        Background="White"/>
                </DockPanel>
                <TextBlock x:Name="PasswordError" Foreground="#F44336" FontSize="10" Margin="0,3,0,0"/>
                
                <!-- Password Strength Meter -->
                <ProgressBar 
                    x:Name="StrengthProgressBar" 
                    Height="6" 
                    Background="#E0E0E0" 
                    Foreground="#F44336"
                    Value="0"
                    Minimum="0"
                    Maximum="100"
                    Margin="0,8,0,2"/>
                <TextBlock 
                    x:Name="StrengthBadge"
                    Text="[Very Weak]"
                    Foreground="#F44336"
                    FontWeight="Bold"
                    FontSize="11"
                    Margin="0,2,0,0"/>
                <TextBlock 
                    x:Name="StrengthRecommendations"
                    Text=""
                    Foreground="#757575"
                    FontSize="10"
                    Margin="0,2,0,0"
                    TextWrapping="Wrap"/>
                
                <!-- Password Generation Options -->
                <Expander Header="Password Generation Options" Margin="0,12,0,0" IsExpanded="False">
                    <StackPanel Margin="10">
                        <!-- Password Length -->
                        <TextBlock Text="Password Length" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="50"/>
                            </Grid.ColumnDefinitions>
                            <Slider
                                x:Name="PasswordLengthSlider"
                                Grid.Column="0"
                                Minimum="16"
                                Maximum="128"
                                Value="32"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0"/>
                            <TextBlock
                                x:Name="PasswordLengthValue"
                                Grid.Column="1"
                                Text="32"
                                Foreground="#1a1a1a"
                                FontWeight="Bold"
                                VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Character Type Checkboxes -->
                        <TextBlock Text="Character Types" FontWeight="Bold" Margin="0,0,0,8"/>
                        <CheckBox
                            x:Name="IncludeUppercaseCheckBox"
                            Content="Include uppercase letters (A-Z)"
                            IsChecked="True"
                            Margin="0,0,0,6"/>
                        <CheckBox
                            x:Name="IncludeLowercaseCheckBox"
                            Content="Include lowercase letters (a-z)"
                            IsChecked="True"
                            Margin="0,0,0,6"/>
                        <CheckBox
                            x:Name="IncludeDigitsCheckBox"
                            Content="Include digits (0-9)"
                            IsChecked="True"
                            Margin="0,0,0,6"/>
                        <CheckBox
                            x:Name="IncludeSymbolsCheckBox"
                            Content="Include symbols (!@#$%...)"
                            IsChecked="True"
                            Margin="0,0,0,12"/>
                        
                        <!-- Exclude Ambiguous -->
                        <CheckBox
                            x:Name="ExcludeAmbiguousCheckBox"
                            Content="Exclude ambiguous characters (0/O, 1/l/I)"
                            IsChecked="False"
                            Margin="0,0,0,0"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
            
            <!-- URL (Optional) -->
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Website URL (Optional)" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox
                    x:Name="UrlBox"
                    Padding="10,8"
                    FontSize="12"
                    BorderThickness="1"
                    BorderBrush="#CCCCCC"
                    Background="White"
                    Foreground="#999999"/>
            </StackPanel>

            <!-- Notes (Optional) -->
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Notes (Optional)" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox
                    x:Name="NotesBox"
                    Padding="10,8"
                    FontSize="12"
                    BorderThickness="1"
                    BorderBrush="#CCCCCC"
                    Background="White"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"
                    MinHeight="90"
                    MaxHeight="140"/>
            </StackPanel>
            
            <!-- Category (Optional) -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Category (Optional)" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox
                    x:Name="CategoryBox"
                    Padding="10,8"
                    FontSize="12"
                    BorderThickness="1"
                    BorderBrush="#CCCCCC"
                    Background="White">
                    <ComboBoxItem>Work</ComboBoxItem>
                    <ComboBoxItem>Personal</ComboBoxItem>
                    <ComboBoxItem>Social Media</ComboBoxItem>
                    <ComboBoxItem>Banking</ComboBoxItem>
                    <ComboBoxItem>Email</ComboBoxItem>
                    <ComboBoxItem>Other</ComboBoxItem>
                </ComboBox>
            </StackPanel>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button 
                Content="Cancel"
                Click="OnCancel"
                Padding="20,10"
                Margin="0,0,10,0"
                Background="#CCCCCC"
                Foreground="#1a1a1a"
                FontWeight="Bold"
                Cursor="Hand"
                BorderThickness="0"
                IsCancel="True"/>
            
            <Button 
                Content="Save Entry"
                Click="OnSave"
                Padding="20,10"
                Background="#2196F3"
                Foreground="White"
                FontWeight="Bold"
                Cursor="Hand"
                BorderThickness="0"
                IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
