<Window x:Class="SecurePasswordManager.App.ImportConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Conflicts - Select Action" Height="400" Width="550"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock 
            Grid.Row="0"
            Text="Select action for duplicate passwords:" 
            FontSize="14" 
            FontWeight="Bold"
            Foreground="#1a1a1a"
            Margin="0,0,0,15"/>

        <!-- Conflict List -->
        <ListBox 
            x:Name="ConflictListBox"
            Grid.Row="1"
            Margin="0,0,0,15"
            BorderThickness="1"
            BorderBrush="#CCCCCC"
            ItemsSource="{Binding}"
            SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,8,0,8">
                        <TextBlock 
                            Text="{Binding ServiceName}" 
                            FontWeight="Bold"
                            Foreground="#1a1a1a"
                            Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <RadioButton 
                                GroupName="Action"
                                Content="Skip this entry"
                                Margin="0,0,20,5"
                                Tag="{Binding Index}"/>
                            <RadioButton 
                                GroupName="Action"
                                Content="Overwrite existing"
                                Margin="0,0,20,5"
                                Tag="{Binding Index}"/>
                            <RadioButton 
                                GroupName="Action"
                                Content="Keep both"
                                Margin="0,0,0,5"
                                Tag="{Binding Index}"
                                IsChecked="True"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button 
                Content="Import" 
                Width="80" 
                Margin="0,0,10,0" 
                Click="OnImport"
                Background="#4CAF50"
                Foreground="White"
                FontWeight="Bold"
                Cursor="Hand"
                BorderThickness="0"/>
            <Button 
                Content="Cancel" 
                Width="80" 
                Click="OnCancel"
                Background="#CCCCCC"
                Foreground="#1a1a1a"
                FontWeight="Bold"
                Cursor="Hand"
                BorderThickness="0"
                IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
