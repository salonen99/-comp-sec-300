<Window x:Class="SecurePasswordManager.App.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Required" Height="200" Width="350"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Message -->
        <TextBlock 
            Grid.Row="0"
            x:Name="MessageBlock"
            Text="{Binding Message, RelativeSource={RelativeSource AncestorType=Window}}"
            FontSize="12"
            Foreground="#1a1a1a"
            Margin="0,0,0,15"
            TextWrapping="Wrap"/>

        <!-- Password Input -->
        <PasswordBox
            Grid.Row="1"
            x:Name="PasswordBox"
            Padding="10,10"
            FontSize="12"
            BorderThickness="1"
            BorderBrush="#CCCCCC"
            Background="White"
            Margin="0,0,0,15"/>

        <!-- Error Message -->
        <TextBlock 
            Grid.Row="2"
            x:Name="ErrorBlock"
            Text=""
            Foreground="#F44336"
            FontSize="11"
            Margin="0,0,0,10"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button 
                Content="OK" 
                Width="80" 
                Margin="0,0,10,0" 
                Click="OnOk"
                Background="#4CAF50"
                Foreground="White"
                FontWeight="Bold"
                Cursor="Hand"
                BorderThickness="0"
                IsDefault="True"/>
            <Button 
                Content="Cancel" 
                Width="80" 
                Click="OnCancel"
                Background="#CCCCCC"
                Foreground="#1a1a1a"
                FontWeight="Bold"
                Cursor="Hand"
                BorderThickness="0"
                IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
