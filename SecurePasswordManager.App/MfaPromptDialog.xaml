<Window x:Class="SecurePasswordManager.App.MfaPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi-Factor Authentication" Height="320" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Complete MFA verification to unlock the vault"
                   FontSize="13"
                   Margin="0,0,0,10"
                   Foreground="#1a1a1a"/>

        <TabControl x:Name="MfaTabControl" Grid.Row="1" Margin="0,0,0,8">
            <TabItem Header="Authenticator Code">
                <StackPanel Margin="12">
                    <TextBlock Text="Enter 6-digit code" Margin="0,0,0,6"/>
                    <TextBox x:Name="TotpCodeBox" MaxLength="6" Padding="8" FontSize="16"/>
                    <TextBlock Text="Use your authenticator app current code."
                               FontSize="11" Foreground="#666666" Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Recovery Code">
                <StackPanel Margin="12">
                    <TextBlock Text="Enter 8-character recovery code" Margin="0,0,0,6"/>
                    <TextBox x:Name="RecoveryCodeBox" MaxLength="8" Padding="8" FontSize="16"/>
                    <TextBlock Text="Recovery codes can be used only once."
                               FontSize="11" Foreground="#666666" Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" x:Name="ErrorText" Foreground="#C62828" FontSize="12" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Verify" Width="90" Margin="0,0,8,0" Click="OnVerify" IsDefault="True"/>
            <Button Content="Cancel" Width="90" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>