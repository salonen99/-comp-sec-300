<Window x:Class="SecurePasswordManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SecurePasswordManager.App"
        mc:Ignorable="d"
        Title="Secure Password Manager" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">
            <!-- Title -->
            <TextBlock 
                Text="Password Vault" 
                FontSize="28" 
                FontWeight="Bold"
                Foreground="#1a1a1a"
                TextAlignment="Center"
                Margin="0,0,0,30"/>
            
            <!-- Status Message -->
            <TextBlock 
                x:Name="StatusMessage"
                Text="Enter your master password to unlock vault"
                FontSize="12"
                Foreground="#666666"
                TextAlignment="Center"
                Margin="0,0,0,20"
                TextWrapping="Wrap"/>
            
            <!-- Master Password Input -->
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Master Password" FontWeight="Bold" Margin="0,0,0,5"/>
                <PasswordBox
                    x:Name="PasswordBox"
                    Padding="10,8"
                    FontSize="14"
                    BorderThickness="1"
                    BorderBrush="#CCCCCC"
                    Background="White"/>
            </StackPanel>
            
            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button 
                    Content="Create Vault"
                    Click="OnCreateVault"
                    Padding="20,10"
                    Margin="0,0,10,0"
                    Background="#4CAF50"
                    Foreground="White"
                    FontWeight="Bold"
                    Cursor="Hand"
                    BorderThickness="0"/>
                
                <Button 
                    Content="Unlock Vault"
                    Click="OnUnlockVault"
                    Padding="20,10"
                    Margin="10,0,0,0"
                    Background="#2196F3"
                    Foreground="White"
                    FontWeight="Bold"
                    Cursor="Hand"
                    BorderThickness="0"/>
            </StackPanel>
            
            <!-- About -->
            <TextBlock 
                Text="Secure implementation of password management"
                FontSize="10"
                Foreground="#999999"
                TextAlignment="Center"
                Margin="0,40,0,0"/>
        </StackPanel>
    </Grid>
</Window>
