<Window x:Class="SecurePasswordManager.App.VaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SecurePasswordManager.App"
        mc:Ignorable="d"
        Title="Password Vault" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        Closing="OnWindowClosing">
    <Grid>
        <DockPanel LastChildFill="True">
            <!-- Menu Bar -->
            <Menu DockPanel.Dock="Top" Background="#FAFAFA" Height="30">
                <MenuItem Header="File" FontSize="12">
                    <MenuItem Header="[+] Import Passwords" Click="OnImportPasswords"/>
                    <MenuItem Header="[&gt;] Export Passwords" Click="OnExportPasswords"/>
                    <Separator/>
                    <MenuItem Header="[LOCK] Lock Vault" Click="OnLockVault"/>
                </MenuItem>
            </Menu>
            
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Background="#2196F3" Margin="0,0,0,0">
                <StackPanel Margin="20">
                    <TextBlock 
                        Text="Password Vault" 
                        FontSize="20" 
                        FontWeight="Bold"
                        Foreground="White"/>
                    <TextBlock 
                        x:Name="VaultStatusText"
                        Text="Vault: [Loaded]" 
                        FontSize="12"
                        Foreground="#E0E0E0"
                        Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>
            
            <!-- Toolbar -->
            <Border DockPanel.Dock="Top" Background="#FAFAFA" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <Button 
                            Content="[+] Add Entry"
                            Click="OnAddEntry"
                            Padding="12,8"
                            Margin="0,0,8,8"
                            Background="#4CAF50"
                            Foreground="White"
                            FontWeight="Bold"
                            Cursor="Hand"
                            BorderThickness="0"/>

                        <Button 
                            Content="[+] Import"
                            Click="OnImportPasswords"
                            Padding="12,8"
                            Margin="0,0,8,8"
                            Background="#795548"
                            Foreground="White"
                            FontWeight="Bold"
                            Cursor="Hand"
                            BorderThickness="0"/>

                        <Button 
                            Content="[↗] Export"
                            Click="OnExportPasswords"
                            Padding="12,8"
                            Margin="0,0,8,8"
                            Background="#6A1B9A"
                            Foreground="White"
                            FontWeight="Bold"
                            Cursor="Hand"
                            BorderThickness="0"/>

                        <Button 
                            Content="[↻] Refresh"
                            Click="OnRefresh"
                            Padding="12,8"
                            Margin="0,0,8,8"
                            Background="#FF9800"
                            Foreground="White"
                            FontWeight="Bold"
                            Cursor="Hand"
                            BorderThickness="0"/>

                        <Button 
                            Content="[⚙] Settings"
                            Click="OnSettings"
                            Padding="12,8"
                            Margin="0,0,8,8"
                            Background="#2196F3"
                            Foreground="White"
                            FontWeight="Bold"
                            Cursor="Hand"
                            BorderThickness="0"/>

                        <Button 
                            Content="[LOCK] Lock Vault"
                            Click="OnLockVault"
                            Padding="12,8"
                            Margin="0,0,8,8"
                            Background="#F44336"
                            Foreground="White"
                            FontWeight="Bold"
                            Cursor="Hand"
                            BorderThickness="0"/>
                    </WrapPanel>

                    <!-- Search box -->
                    <TextBox
                        Grid.Column="1"
                        x:Name="SearchBox"
                        Width="300"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="8"
                        TextChanged="SearchBox_TextChanged"/>
                </Grid>
            </Border>
            
            <!-- Content Area -->
            <Grid DockPanel.Dock="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Entry List with Category Grouping -->
                <Border BorderBrush="#CCCCCC" BorderThickness="1" Margin="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl 
                            x:Name="EntriesItemsControl"
                            Background="White">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!-- Category Header -->
                                        <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                                            <TextBlock 
                                                Text="{Binding Key}" 
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="#2196F3"
                                                Padding="10,15,10,5"
                                                Margin="0,0,0,0"/>
                                        </Border>
                                        
                                        <!-- Entries in Category -->
                                        <ItemsControl ItemsSource="{Binding Value}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="180"/>
                                                                <ColumnDefinition Width="180"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="220"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <!-- Service Name -->
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Service" FontSize="10" Foreground="#999999" Margin="0,0,0,2"/>
                                                                <TextBlock Text="{Binding ServiceName}" FontSize="14" FontWeight="Bold" Foreground="#1a1a1a"/>
                                                            </StackPanel>
                                                            
                                                            <!-- Username -->
                                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                                <TextBlock Text="Username" FontSize="10" Foreground="#999999" Margin="0,0,0,2"/>
                                                                <TextBlock Text="{Binding Username}" FontSize="12" Foreground="#333333"/>
                                                            </StackPanel>
                                                            
                                                            <!-- Password (masked) -->
                                                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                                                <TextBlock Text="Password" FontSize="10" Foreground="#999999" Margin="0,0,0,2"/>
                                                                <TextBlock Text="••••••••••" FontSize="12" Foreground="#666666"/>
                                                            </StackPanel>
                                                            
                                                            <!-- Actions -->
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
                                                                <Button 
                                                                    Content="View"
                                                                    Click="OnViewPassword"
                                                                    Padding="8,5"
                                                                    Margin="0,0,5,0"
                                                                    Background="#9C27B0"
                                                                    Foreground="White"
                                                                    FontSize="11"
                                                                    Cursor="Hand"
                                                                    BorderThickness="0"/>
                                                                <Button 
                                                                    Content="Copy"
                                                                    Click="OnCopyPassword"
                                                                    Padding="8,5"
                                                                    Margin="0,0,5,0"
                                                                    Background="#607D8B"
                                                                    Foreground="White"
                                                                    FontSize="11"
                                                                    Cursor="Hand"
                                                                    BorderThickness="0"/>
                                                                <Button 
                                                                    Content="Edit"
                                                                    Click="OnEditEntry"
                                                                    Padding="8,5"
                                                                    Margin="0,0,5,0"
                                                                    Background="#2196F3"
                                                                    Foreground="White"
                                                                    FontSize="11"
                                                                    Cursor="Hand"
                                                                    BorderThickness="0"/>
                                                                <Button 
                                                                    Content="Delete"
                                                                    Click="OnDeleteEntry"
                                                                    Padding="8,5"
                                                                    Background="#F44336"
                                                                    Foreground="White"
                                                                    FontSize="11"
                                                                    Cursor="Hand"
                                                                    BorderThickness="0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                
                <!-- Status Bar -->
                <TextBlock 
                    x:Name="StatusText"
                    Grid.Row="1"
                    Text="✓ Vault unlocked"
                    Margin="20,10,20,10"
                    Background="#E8F5E9"
                    Foreground="#2E7D32"
                    FontSize="12"/>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
