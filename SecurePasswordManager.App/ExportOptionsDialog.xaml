<Window x:Class="SecurePasswordManager.App.ExportOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Options" Height="300" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock 
            Grid.Row="0"
            Text="Export Vault Passwords" 
            FontSize="14" 
            FontWeight="Bold"
            Foreground="#1a1a1a"
            Margin="0,0,0,15"/>

        <!-- Format Selection -->
        <TextBlock 
            Grid.Row="1" 
            Text="Export Format:" 
            FontWeight="Bold"
            Margin="0,0,0,8"/>
        
        <StackPanel Grid.Row="2" Margin="10,0,0,15">
            <RadioButton 
                x:Name="CsvRadioButton"
                Content="CSV (service, username, password, ...)"
                IsChecked="True"
                Margin="0,0,0,8"/>
            <RadioButton 
                x:Name="JsonRadioButton"
                Content="JSON (structured format)"
                Margin="0,0,0,0"/>
        </StackPanel>

        <!-- Encryption Selection -->
        <TextBlock 
            Grid.Row="3" 
            Text="Security:" 
            FontWeight="Bold"
            Margin="0,0,0,8"/>
        
        <StackPanel Grid.Row="4" Margin="10,0,0,0">
            <CheckBox 
                x:Name="EncryptCheckbox"
                Content="Encrypt with master password (recommended)"
                IsChecked="True"
                Margin="0,0,0,12"/>
            
            <TextBlock 
                Text="❌ Warning: Plaintext exports are less secure!" 
                Foreground="#F44336"
                FontSize="11"
                Margin="20,0,0,8"
                TextWrapping="Wrap"/>
            <TextBlock 
                Text="Unchecking encryption will save passwords in plain text. This is only recommended for temporary exports that you will delete immediately after use."
                Foreground="#F57C00"
                FontSize="10"
                Margin="20,0,0,0"
                TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button 
                Content="Export" 
                Width="80" 
                Margin="0,0,10,0" 
                Click="OnExport"
                Background="#4CAF50"
                Foreground="White"
                FontWeight="Bold"
                Cursor="Hand"
                BorderThickness="0"/>
            <Button 
                Content="Cancel" 
                Width="80" 
                Click="OnCancel"
                Background="#CCCCCC"
                Foreground="#1a1a1a"
                FontWeight="Bold"
                Cursor="Hand"
                BorderThickness="0"
                IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
